# pixi environments
.pixi/*
!.pixi/config.toml

# local OS / interpreter byproducts
.DS_Store
__pycache__/
.pytest_cache/
benchmarks/__pycache__/
benchmarks/julia-env/*
!benchmarks/julia-env/Project.toml
!benchmarks/julia-env/Manifest.toml

# generated benchmark data
*.parquet
benchmarks/data/*.hash

# Correia HDFE benchmark data is downloaded separately; retain its metadata.
benchmarks/data/correia_data/*.csv
benchmarks/data/correia_data/.downloads/

# Generated paper summaries are tracked; raw benchmark results remain local.
results/runs/
results/legacy/
benchmarks/results/
benchmarks/modular/*.csv
figures/benchmarks/

# local Codex skill marker
academic-voice.skill
academic-voice/

# local assistant/project metadata
.claude/
