# pixi environments
.pixi/*
!.pixi/config.toml

# local OS / interpreter byproducts
.DS_Store
__pycache__/
.pytest_cache/
benchmarks/__pycache__/
benchmarks/julia-env/*
!benchmarks/julia-env/Project.toml
!benchmarks/julia-env/Manifest.toml

# generated benchmark data
*.parquet
benchmarks/data/*.hash

# Correia HDFE benchmark data is downloaded separately; retain its metadata.
benchmarks/data/correia_data/*.csv
benchmarks/data/correia_data/.downloads/

# Raw benchmark output remains local; the canonical paper summary is tracked separately.
results/runs/
results/legacy/
benchmarks/results/
figures/benchmarks/

# Typst tables and scalar bindings are rebuilt from the tracked paper-result snapshot.
generated/

# local Codex skill marker
academic-voice.skill
academic-voice/

# local assistant/project metadata
.claude/
BENCHMARK_BACKLOG.md
BENCHMARK_ESSENTIALS_PLAN.md
BENCHMARK_SIMPLIFICATION_PLAN.md
